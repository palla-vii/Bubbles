# MongoDB Atlas Connection String
# Replace username, password, and cluster-name with your actual MongoDB details
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mern-chat?retryWrites=true&w=majority

# JWT Secret Key for token signing and verification
# Use a strong random string (min 32 characters) for production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_to_a_random_string

# Server Port
PORT=5000

# Environment
NODE_ENV=development

# Frontend URL for CORS (use * for development, specify domain for production)
CLIENT_URL=http://localhost:5173
